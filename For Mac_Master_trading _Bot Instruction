#!/bin/bash
# Upload Master Trading Bot to GitHub
# 
# INSTRUCTIONS:
# 1. Update YOUR_GITHUB_USERNAME and YOUR_REPO_NAME below
# 2. Run this script from the directory containing master_trading_bot.py
# 3. You may be prompted for GitHub credentials

# Configuration - UPDATE THESE!
GITHUB_USERNAME="YOUR_GITHUB_USERNAME"
REPO_NAME="YOUR_REPO_NAME"

# Check if file exists
if [ ! -f "master_trading_bot.py" ]; then
    echo "❌ Error: master_trading_bot.py not found in current directory"
    exit 1
fi

echo "🚀 Uploading Master Trading Bot to GitHub..."
echo "Repository: https://github.com/$GITHUB_USERNAME/$REPO_NAME"

# Initialize git if not already initialized
if [ ! -d ".git" ]; then
    echo "Initializing git repository..."
    git init
    git remote add origin "https://github.com/$GITHUB_USERNAME/$REPO_NAME.git"
fi

# Add the file
git add master_trading_bot.py

# Commit
git commit -m "Add master trading bot - combined best features from all versions

Features:
- Rich Discord alerts with embeds
- Hourly status updates & EOD summaries
- Streaming + Polling modes (fallback)
- Connection retry with exponential backoff
- Google Colab optimized
- File logging
- .env support
- Configurable threshold (4 or 6)
- Market hours filter for entries
- 24/7 exit monitoring"

# Push to GitHub
echo "Pushing to GitHub..."
git push -u origin main

echo "✅ Upload complete!"
echo "View your repository: https://github.com/$GITHUB_USERNAME/$REPO_NAME"
