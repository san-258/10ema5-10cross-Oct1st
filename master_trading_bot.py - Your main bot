def send_discord_embed(message, title="Trading Bot", color=3447003, fields=None):
    """Send rich embed to Discord"""
    if not DISCORD_WEBHOOK_URL or len(DISCORD_WEBHOOK_URL) < 20:
        return

    embed = {
        "title": title,
        "description": message,
        "color": color,
        "timestamp": datetime.utcnow().isoformat(),
        "footer": {"text": "Master Trading Bot"}
    }

    if fields:
        embed["fields"] = fields

    try:
        requests.post(DISCORD_WEBHOOK_URL, json={"embeds": [embed]}, timeout=10)
    except Exception as e:
        logger.error(f"Discord embed error: {e}")


def send_discord_text(message: str):
    """Send plain text message to Discord"""
    if not DISCORD_WEBHOOK_URL or len(DISCORD_WEBHOOK_URL) < 20:
        return

    try:
        timestamp = datetime.now().strftime("%H:%M:%S")
        formatted_message = f"[{timestamp}] {message}"
        resp = requests.post(
            DISCORD_WEBHOOK_URL,
            json={"content": formatted_message},
            timeout=10
        )
        if resp.status_code not in (200, 204):
            logger.warning(f"Discord webhook error {resp.status_code}")
    except Exception as e:
        logger.error(f"Discord send failed: {e}")


