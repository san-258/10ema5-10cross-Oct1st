@echo off
REM Upload Master Trading Bot to GitHub (Windows)
REM 
REM INSTRUCTIONS:
REM 1. Update YOUR_GITHUB_USERNAME and YOUR_REPO_NAME below
REM 2. Run this script from the directory containing master_trading_bot.py
REM 3. You may be prompted for GitHub credentials

REM Configuration - UPDATE THESE!
set GITHUB_USERNAME=YOUR_GITHUB_USERNAME
set REPO_NAME=YOUR_REPO_NAME

echo Uploading Master Trading Bot to GitHub...
echo Repository: https://github.com/%GITHUB_USERNAME%/%REPO_NAME%

REM Check if file exists
if not exist master_trading_bot.py (
    echo Error: master_trading_bot.py not found in current directory
    pause
    exit /b 1
)

REM Initialize git if not already initialized
if not exist .git (
    echo Initializing git repository...
    git init
    git remote add origin https://github.com/%GITHUB_USERNAME%/%REPO_NAME%.git
)

REM Add the file
git add master_trading_bot.py

REM Commit
git commit -m "Add master trading bot - combined best features from all versions"

REM Push to GitHub
echo Pushing to GitHub...
git push -u origin main

echo Upload complete!
echo View your repository: https://github.com/%GITHUB_USERNAME%/%REPO_NAME%
pause
